{
  "appId": "ai.ppq.voice",
  "productName": "PPQ Whisper",
  "directories": {
    "output": "dist"
  },
  "npmRebuild": true,
  "buildDependenciesFromSource": true,
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "node_modules/**/*",
    "src/dist/**/*",
    "src/helpers/**/*",
    "src/hooks/**/*",
    "src/services/**/*",
    "src/stores/**/*",
    "src/config/**/*",
    "src/types/**/*",
    "src/models/**/*",
    "src/utils.js",
    "src/utils/**/*",
    "src/updater.js",
    "src/components.json",
    "!node_modules/.cache/**/*",
    "!src/node_modules/**/*"
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/tsx/**/*",
    "**/node_modules/esbuild/**/*",
    "**/node_modules/@esbuild/**/*",
    "**/node_modules/get-tsconfig/**/*",
    "**/node_modules/ppq-private-mode/**/*",
    "**/node_modules/tinfoil/**/*",
    "**/node_modules/@tinfoilsh/**/*",
    "**/node_modules/ehbp/**/*",
    "**/node_modules/openai/**/*",
    "**/node_modules/@ai-sdk/**/*",
    "**/node_modules/ai/**/*",
    "**/node_modules/zod/**/*",
    "**/node_modules/openclaw/**/*",
    "**/node_modules/@freedomofpress/**/*",
    "**/node_modules/@sigstore/**/*"
  ],
  "extraResources": [
    ".env",
    "src/assets/**/*",
    "resources/macos-globe-listener.swift",
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": ["macos-globe-listener*"]
    },
    {
      "from": "resources/bin",
      "to": "bin",
      "filter": ["sherpa-onnx-*", "libsherpa*", "libonnx*", "libkaldi*"]
    }
  ],
  "mac": {
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "src/assets/icon.icns",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "entitlements": "resources/mac/entitlements.mac.plist",
    "entitlementsInherit": "resources/mac/entitlements.mac.plist",
    "identity": "New Caird Technologies, Inc. (VA6H89CJ5R)",
    "extendInfo": {
      "LSUIElement": false,
      "NSMicrophoneUsageDescription": "PPQ Whisper needs microphone access for speech-to-text transcription.",
      "NSAccessibilityUsageDescription": "PPQ Whisper needs accessibility permissions to paste transcribed text into other applications."
    }
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "src/assets/icon.ico"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "src/assets/icon.png",
    "category": "Utility"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "dmg": {
    "title": "PPQ Whisper",
    "icon": "src/assets/icon.icns",
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "publish": {
    "provider": "github",
    "owner": "PayPerQ",
    "repo": "ppq-voice-releases",
    "private": false,
    "releaseType": "release"
  }
}
