# Private Whisper Environment Variables

# Required: PPQ API key for speech-to-text (STT)
PPQ_API_KEY=your_ppq_api_key_here

# Optional: Custom PPQ endpoint URLs (defaults shown)
# PPQVOICE_PPQ_TRANSCRIPTION_BASE_URL=https://dev.ppq.ai/api/v1
# PPQVOICE_PPQ_CHAT_BASE_URL=https://api.ppq.ai
# PPQVOICE_PPQ_BASE_URL=https://api.ppq.ai
# VITE_PPQ_WEBSITE_URL=https://ppq.ai

# Optional: WebSocket URL for streaming transcription
# For local development: ws://localhost:4002
# PPQVOICE_PPQ_WS_BASE_URL=wss://horsepower.ppq.ai

# Optional: Supabase logging (Edge Function)
SUPABASE_FUNCTIONS_BASE_URL=https://your-project-ref.functions.supabase.co
SUPABASE_LOG_FUNCTION_NAME=voice-logs
SUPABASE_LOG_TABLE=voice_pipeline_logs

# Optional: Verbose logging
PPQVOICE_DEBUG=false
